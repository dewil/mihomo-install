# Подписка + rules: mihomo-build-config и reload через API (без рестарта процесса).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Раз в две минуты со случайной задержкой 0-59 с.
#
# Почему не каждую минуту и не в одну секунду. Замер 08.09.2026 на s79:
# агрегатор подписки получает ~900 запросов в час, из них ~346 - это наши
# шесть машин каскада, и все они били в одну и ту же секунду каждой минуты.
# Каждый промах кеша разворачивается на этой стороне в обход всех панелей,
# поэтому синхронный залп шести клиентов - худший из возможных профилей
# нагрузки. Интервал в две минуты снижает нашу долю вдвое, задержка
# декоррелирует машины между собой.
#
# Задержка стоит ЗДЕСЬ, а не внутри mihomo-refresh, сознательно: ручной
# прогон во время разбора должен отвечать сразу, а не спать до минуты.
# Планирование - забота крона, скрипт остается предсказуемым.
#
# sleep до flock, а не после: лок берется на саму работу, и timeout 300
# отсчитывает работу, а не сон. shuf - из coreutils, есть на всех нодах;
# $RANDOM тут нельзя, SHELL=/bin/sh. Фолбэк на 0 обязателен: без него
# отсутствие shuf даст sleep без аргумента, && отменит прогон, и нода
# перестанет обновляться молча.
#
# flock -n: без лока прогоны накладываются - на s79 такая связка дала пачку
# в ~1200 процессов и убила прокси на 7890. timeout - страховка от зависшего
# прогона, который иначе держал бы лок вечно.
*/2 * * * * root sleep $(shuf -i 0-59 -n 1 2>/dev/null || echo 0) && flock -n /run/mihomo-refresh.lock timeout 300 /usr/local/sbin/mihomo-refresh
